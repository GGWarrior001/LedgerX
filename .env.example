# ─────────────────────────────────────────────────────────────
# LedgerX — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# ── Firebase (optional — required only for cloud sync) ────────
# Find these in Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Optional: Firebase Analytics measurement ID ───────────────
# Leave blank to disable Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# ── App behaviour ─────────────────────────────────────────────
# Set to "true" to enable verbose debug logging in the browser console
VITE_DEBUG=false
