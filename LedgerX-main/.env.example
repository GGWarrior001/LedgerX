# ─────────────────────────────────────────────────────────────
# LedgerX — Environment Variables
# 
# SECURITY: NEVER commit .env to source control
# SECURITY: Use strong, unique values for all secrets
# SECURITY: Rotate credentials regularly
# SECURITY: Use different credentials for dev/staging/production
# ─────────────────────────────────────────────────────────────

# ── Firebase (optional — required only for cloud sync) ────────
# Find these in Firebase Console → Project Settings → Your apps → Web app
# SECURITY: Restrict Firebase rules to your domain only
# SECURITY: Enable reCAPTCHA for auth endpoints
# SECURITY: Use service account keys for admin operations, never in client code
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Optional: Firebase Analytics measurement ID ───────────────
# Leave blank to disable Analytics
# SECURITY: Consider privacy implications of analytics
VITE_FIREBASE_MEASUREMENT_ID=

# ── App behaviour ─────────────────────────────────────────────
# Set to "true" to enable verbose debug logging in the browser console
# SECURITY: Disable debug mode in production (exposes sensitive info)
VITE_DEBUG=false

# ── Deployment Security Notes ─────────────────────────────────
# 1. Enable HTTPS-only in production
# 2. Set secure cookies (HttpOnly, SameSite, Secure flags)
# 3. Use CSP headers (configured in index.html)
# 4. Run regular dependency audits: npm audit
# 5. Keep Node.js and dependencies up to date
# 6. Run security linting: npm run lint
# 7. Deploy Firestore security rules before going to production
